      {
        "server": "ru-dns",
        "rule_set": [
          "private",
          "category-ru",
          "whitelist"
        ]
      },
      {
        "server": "fakeip-dns",
        "query_type": [
          "A",
          "AAAA"
        ]
      },
      {
        "server": "google-doh"
      }
    ],
    "fakeip": {
      "enabled": true,
      "inet4_range": "198.18.0.0/15",
      "inet6_range": "fc00::/18"
    },
    "servers": [
      {
        "tag": "ru-dns",
        "detour": "direct",
        "address": "77.88.8.8",
        "strategy": "ipv4_only",
        "address_strategy": "prefer_ipv4"
      },
      {
        "tag": "google-doh",
        "detour": "→ Remnawave",
        "address": "https://8.8.8.8/dns-query",
        "strategy": "ipv4_only",
        "address_strategy": "prefer_ipv4"
      },
      {
        "tag": "fakeip-dns",
        "address": "fakeip"
      }
    ],
    "independent_cache": true
  },
